# Godot editor cache and per-machine state — regenerated on open.
.godot/

# Exported builds
/build/
/export/
*.exe
*.pck
*.zip

# Mono/C# leftovers (this project is GDScript, but the editor is a Mono build)
.mono/
*.csproj
*.sln

# NOTE: *.uid files are deliberately NOT ignored. Godot 4.4+ uses them as the
# stable identity of each script; excluding them breaks references on clone.

# Python bytecode from tools/
__pycache__/

# Blender's backup of the previous save, written next to every .blend.
*.blend1

# Renders of the 3D models: regenerated from the .blend sources whenever the
# model changes, and several MB of binary a time. The .blend files and the
# .glb exports the preview scene loads are what is kept.
/resources/3d/*.png
/resources/3d/*.png.import
/resources/3d/*.gif
